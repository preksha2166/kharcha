# Copy this file to .env and fill in your own values. Never commit .env.

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > your sandbox app) ---
# Leave both empty to run in MOCK mode (fake PayPal responses, clearly labeled in the UI).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from your sandbox app's webhook settings (after you deploy to a public URL)
PAYPAL_WEBHOOK_ID=

# Sandbox accounts that receive money in the demo (Payouts). Use your sandbox personal account emails.
DEMO_LANDLORD_EMAIL=
DEMO_COLLEGE_EMAIL=

# --- Gemini API (free key: aistudio.google.com > Get API key) ---
# Leave empty to run without AI (simple template messages, extraction disabled).
GEMINI_API_KEY=
# Optional. Default gemini-3.6-flash. Other free-tier choices: gemini-3.8-flash, gemini-3.5-flash-lite
GEMINI_MODEL=

# --- App ---
# SQLite locally. For a server, a free Postgres (e.g. Neon) URL works too: postgresql://user:pass@host/db
DATABASE_URL=sqlite:///./kharcha.db
# true: demo clock + a demo student anyone can try without logging in. false: everyone logs in with PayPal.
DEMO_MODE=true
# Where the React app runs (used for PayPal return URLs and CORS)
FRONTEND_URL=http://localhost:5173
# Fixed demo exchange rate, shown as "demo rate" in the UI
FX_INR_PER_USD=88
STUDENT_TIMEZONE=America/Los_Angeles

# --- Real-world extras (all optional, all free) ---
# Estimated PayPal fee shown on bills (check PayPal's fee page for your country)
PAYPAL_FEE_PERCENT=3.49
PAYPAL_FEE_FIXED=0.49
# A long random string. A free timer (cron-job.org) calls /api/cron/daily-check?key=THIS every hour,
# so a sleeping free server never misses a bill day. Empty = the URL is off.
CRON_SECRET=
# Email alerts through any SMTP account (e.g. Gmail with an app password, or a free Brevo account).
# Empty SMTP_HOST = email off. Port 587 uses STARTTLS; 465 uses SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Phone/browser alerts (Web Push). Leave empty: Kharcha makes keys once and saves them in the database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
